# ============================================================
# Variables d'environnement LOCALES (.env, jamais commite).
# Documentation des cles, SANS valeurs. Pour le cron quotidien, ces memes
# cles vont dans GitHub > Settings > Secrets and variables > Actions.
# Rappel : tout VITE_* finit EN CLAIR dans le bundle. Aucun secret en VITE_*.
# ============================================================

# --- Sanity : identifiants publics par design (lecture seule via CDN) ---
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# --- Admin local (npm run admin) ---
# Optionnel : si defini, server.js exige ce mot de passe (sinon acces libre,
# limite a localhost par le CORS). ADMIN_API_KEY reste accepte comme alias.
ADMIN_PASSWORD=

# --- Dashboard stats : rideau d'acces en prod (VITE_* car cote client) ---
# C'est un RIDEAU, pas un coffre : hash SHA-256 du mot de passe, embarque
# dans le bundle. Generer le hash :
#   node -e "crypto.subtle.digest('SHA-256',new TextEncoder().encode('TON_MDP')).then(b=>console.log(Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('')))"
# Puis coller la valeur dans .env.production (commitable : c'est un hash).
VITE_STATS_PASSWORD_HASH=

# --- YouTube Data API v3 (cle simple, console.cloud.google.com) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- YouTube Analytics (geo des vues) : OAuth one-shot ---
# 1. Creer un client OAuth "Application de bureau" dans Google Cloud
# 2. Remplir les 2 cles ci-dessous
# 3. node scripts/youtube-oauth.mjs  -> donne YT_REFRESH_TOKEN
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Spotify (developer.spotify.com, client credentials) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Meta Graph API v21 (Instagram Business + Page Facebook) ---
# Token long-lived depuis Business Suite / Graph API Explorer.
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=

# --- SoundCloud (module optionnel : sans cle, source "desactive") ---
SOUNDCLOUD_CLIENT_ID=
