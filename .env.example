# Copier en .env.local et remplir. .env.local n'est JAMAIS commite.
#
# REGLE ABSOLUE
# Tout ce qui est prefixe VITE_ est inline par Vite dans le bundle front,
# qui est public : n'importe qui peut le lire dans dist/assets/*.js.
# => Un secret ne doit JAMAIS etre un VITE_*.

# ---------------------------------------------------------------
# PUBLIC (front) — sans danger dans le bundle
# ---------------------------------------------------------------

# Sanity : identifiants publics par design (lecture seule via CDN)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# URL de l'API d'ecriture (Render). Publique : c'est juste une adresse,
# l'ecriture est protegee par le mot de passe admin cote serveur.
# Laisser vide en local (le front tape alors http://localhost:3001).
VITE_API_URL=

# ---------------------------------------------------------------
# SERVEUR uniquement — a definir sur Render, jamais ici en clair
# ---------------------------------------------------------------
# Ces variables ne sont PAS lues par le front. Elles sont listees pour
# documentation ; leur vraie valeur vit dans le dashboard Render.
#
# ADMIN_PASSWORD    Mot de passe saisi dans l'ecran de login admin.
#                   (ADMIN_API_KEY est encore accepte comme alias.)
# GITHUB_TOKEN      PAT fine-grained, portee minimale : contents:write
#                   sur le seul repo du site.
# GITHUB_REPO       mauditemachine/MauditeMachine
# ALLOWED_ORIGIN    https://mauditemachine.com
#
# En local, pour tester l'auth du serveur de dev :
#   ADMIN_PASSWORD=un-mot-de-passe-de-test npm run server
