# Variables de build PRODUCTION (npm run build).
# Ce fichier EST commite : il ne contient aucun secret.
#
# Rappel : tout VITE_* est inline en clair dans dist/assets/*.js.
# Ne jamais mettre ici un mot de passe, un token ou une cle privee.

# VITE_API_URL est volontairement ABSENTE.
# Il n'existe aucun serveur d'ecriture distant pour ce site : l'admin en
# ligne est desactive par conception, et l'affiche clairement.
# L'edition passe par l'admin local (npm run dev + node server.js) ou par
# une mise a jour directe de public/releases.json versionnee dans le depot.
# Ne pas re-ajouter VITE_API_URL sans avoir un serveur reellement deploye
# ET joignable (verifier par curl avant de cabler quoi que ce soit).

# Sanity : identifiants publics par design (lecture seule via CDN).
VITE_SANITY_PROJECT_ID=ofkhqlly
VITE_SANITY_DATASET=production

# Rideau d'acces aux outils admin consultables en prod (/mm-admin/radar,
# /mm-admin/stats). C'est un HASH SHA-256 (commitable), pas le mot de passe.
# Pour changer le mot de passe : generer un nouveau hash (commande dans
# .env.example) et remplacer la valeur ci-dessous.
VITE_STATS_PASSWORD_HASH=517cfb8996d86ea717fb98b0eb90d679082b3ef0aa67d0c31e0c49879e6a5b9b
