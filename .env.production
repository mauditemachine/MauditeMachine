# Variables de build PRODUCTION (npm run build).
# Ce fichier EST commite : il ne contient aucun secret.
#
# Rappel : tout VITE_* est inline en clair dans dist/assets/*.js.
# Ne jamais mettre ici un mot de passe, un token ou une cle privee.
# Le mot de passe admin (ADMIN_PASSWORD) vit uniquement sur Render.

# URL de l'API d'ecriture (Render). Publique : c'est une simple adresse,
# l'ecriture derriere est protegee par mot de passe cote serveur.
# Sans cette valeur, getApiUrl() renvoie vide et toutes les ecritures de
# production echouent en silence (bug constate avant ce correctif).
VITE_API_URL=https://mauditemachine-api.onrender.com

# Sanity : identifiants publics par design (lecture seule via CDN).
VITE_SANITY_PROJECT_ID=ofkhqlly
VITE_SANITY_DATASET=production
