              rel="noreferrer"
            >
              Presskit & Techrider
            </a>
          </li>
        </ul>
      </nav>

      {/* Navigation en haut du site */}
      <div className="second-third-combined">
        {/* Boutons de navigation en haut */}
        <div className="nav-buttons">
          <button
            className={`nav-btn ${activeSection === "home" ? "active" : ""}`}
            onClick={() => setActiveSection("home")}
          >
            HOME
          </button>
          <button
            className={`nav-btn ${activeSection === "events" ? "active" : ""}`}
            onClick={() => setActiveSection("events")}
          >
            EVENTS
          </button>
          <button className="nav-btn">DISCO</button>
          <button className="nav-btn">MEDIAS</button>
          <button className="nav-btn">STORE</button>
          <button className="nav-btn">MESSAGE</button>
          <button className="nav-btn">PRESSKIT</button>
        </div>

        {/* Rectangle principal sous les boutons */}
        <div className="main-rectangle">
          {activeSection === "home" && (
            <>
              <div className="bio-text">
                <p>Maudite Machine is the founder and owner of VRSTL Records, a
                Canadian label dedicated to dark disco and indie dance. This
                Montreal-based DJ and producer has established himself as a
                driving force in the electronic music scene through performances
                at renowned events including Piknic Électronik, Eclipse
                Festival, and the iconic Techno Parade in Paris.</p>
                <p>With a distinctive sound that blends deep basslines, hypnotic rhythms,
                and dark atmospheric elements, Maudite Machine has captivated
                audiences across Canada and Europe. His sets seamlessly navigate
                between indie dance and dark minimal, creating immersive
                experiences that have become his signature. </p><p>Having shared the
                stage with electronic music legends including Carl Craig, Popof,
                Electric Rescue, The Hacker, Ellen Allien, Riva Starr, and
                Agoria, among many other industry titans, Maudite Machine has
                proven his ability to hold his own among the genre's most
                respected artists. <p></p>Through VRSTL Records, he champions bold
                artists who share his vision for the darker, more experimental
                sides of electronic music. His collaborations with established
                industry figures and his role in nurturing emerging talent have
                positioned him as an influential curator and tastemaker in the
                indie dance movement. </p>From Montreal's underground scene to
                international stages, Maudite Machine continues to push creative
                boundaries while building a distinctive legacy in electronic
                music.
              </div>
              <NewsMessages />
            </>
          )}
          {activeSection === "events" && <EventsDisplay />}
        </div>
      </div>

      <main className="main-content">
        {/* Logo principal MAUDITE MACHINE */}
        <div className="main-logo">
          <img
            src="/medias/logo/mauditemachine-logo.png"
            alt="Maudite Machine"
          />
        </div>

        {/* Player SoundCloud en dessous du logo */}
        <div className="player-section" style={{ marginTop: "20px" }}>
          <SoundCloudPlayer onBackgroundChange={(url) => setBgUrl(url)} />
        </div>
      </main>

      <footer className="bottom">
