node_modules/
.DS_Store
*.log
OLD/
.claude/
.worktrees/
api/.env
/public/images/hero/_old/
*\ [2-9].*
*\ [1-9][0-9].*
node_modules\ [0-9]*

# Secrets : aucun .env ne doit etre suivi par git.
# Deux exceptions, qui ne contiennent AUCUN secret :
#   .env.example    documentation des variables, sans valeurs
#   .env.production valeurs publiques du build prod (URL API, ids Sanity)
# Tout VITE_* etant inline en clair dans le bundle, ces fichiers ne doivent
# jamais recevoir de mot de passe ni de token.
.env
.env.*
!.env.example
!.env.production

# Sources haute-res des goodies (131 Mo).
# Le site ne sert que les .webp, qui restent suivis normalement. Les .png et
# .jpg d'origine ne sont references nulle part : ce sont les fichiers qui ont
# servi a generer les webp. Ils restent en local, hors depot.
# Sans ca, le `git add -A` de deploy.sh les embarquerait par accident dans un
# depot qui est aussi ce que GitHub Pages sert.
/public/images/goodies/**/*.png
/public/images/goodies/**/*.jpg
/public/images/goodies/**/*.jpeg

# Stats privees (revenus Ditto) et CSV sources : local uniquement.
# Ancre a la racine : public/data/ (stats publiques) reste versionne.
/data/
.admin-backups/

# .nosync : dossiers regenerables sortis de la sync iCloud (+ lien symbolique du meme nom)
*.nosync
*.nosync/
node_modules
.next

# Sorties regenerables des scripts (ex. footprints.csv de
# scripts/seo-backlinks-footprints.js) : local uniquement.
scripts/output/

# IndexNow (2026-10-21) : la liste des adresses changees au dernier build (scripts/generate-sitemap.mjs)
indexnow-urls.txt

# Le moteur du MM-ARP pour le navigateur (2026-11-25, /mm-arp/play/) : refait par la CI (scripts/build-arp-wasm.sh,
# npm run plugin:arp:wasm), jamais suivi par git
/public/mm-arp/mm-arp-engine.wasm
# Le moteur du MM-RYTM pour le navigateur (2026-11-25, /mm-rytm/play/) : refait par la CI (scripts/build-rytm-wasm.sh,
# npm run plugin:rytm:wasm), jamais suivi par git
/public/mm-rytm/mm-rytm-engine.wasm
